# Copy this file to .env and fill in as needed:
#   cp .env.example .env

# Only needed if the backend isn't on the default http://localhost:8787.
VITE_API_URL=

# Optional — enables the "Continue with Google" button in the sign-in dialog.
# Must match GOOGLE_CLIENT_ID in backend/.env. See the README's "Accounts,
# saved plans, and Google sign-in" section for how to create one.
VITE_GOOGLE_CLIENT_ID=

# Copy this file to .env and fill in as needed:
#   cp .env.example .env

# Only needed if the backend isn't on the default http://localhost:8787.
# Always used directly for the SSE stream, and for every request when no
# gateway is configured below.
VITE_API_URL=

# --- Fission AI Portal integration ---
# Set these to run Prism as a microfrontend inside the portal. Leave them
# blank and Prism runs standalone with no identity at all: it loads, but
# every signed-in page ("My Plans", "My Bookings", …) shows "Not signed in",
# because only the portal can authenticate a user now.

# The portal gateway's base URL. JSON requests then route through its
# authenticated proxy instead of going to VITE_API_URL directly.
VITE_GATEWAY_API_URL=

# Origin of the portal shell, for the postMessage handshake. Must match the
# portal exactly — messages from any other origin are ignored.
VITE_PORTAL_ORIGIN=

# `appName` of Prism's record in the portal's Applications table — the
# gateway resolves which backend to forward to by this name.
VITE_PORTAL_APP_NAME=Prism

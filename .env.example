# Copy to .env for `docker compose up`.  Only JWT_SECRET is required.
#   cp .env.example .env

# Signs auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the browser reaches the backend. Default works for local compose.
# Override when the backend is published on another host/port. Baked into the
# frontend bundle at build time — changing it needs a frontend rebuild.
VITE_API_URL=http://localhost:8787

# Allowed browser origin(s) for the backend's CORS, comma-separated. Blank =
# reflect any origin (fine locally). In production set to the frontend URL(s),
# e.g. https://app.example.com
CORS_ORIGIN=

# LLM provider: groq (default) or bedrock. Leave the keys blank and every
# agent falls back to deterministic mock data — the app still runs.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Only used when LLM_PROVIDER=bedrock. On AWS (EC2 / ECS) leave the keys blank
# and set AWS_USE_IAM_ROLE=true — the SDK then uses the instance / task role.
AWS_USE_IAM_ROLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Haiku 4.5 by default (fast); use us.anthropic.claude-sonnet-5 for max quality.
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_TIMEOUT_SCALE=2

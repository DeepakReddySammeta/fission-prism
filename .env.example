# Copy to .env for `docker compose up`.
#   cp .env.example .env

# Where the browser reaches the backend. Default works for local compose.
# Override when the backend is published on another host/port. Baked into the
# frontend bundle at build time — changing it needs a frontend rebuild.
VITE_API_URL=http://localhost:8787

# --- Fission AI Portal integration ---
# Set these to run Prism as a microfrontend inside the portal. Leave them blank
# and Prism talks to its backend directly, with no identity — signed-in
# features return 401.
#
# The portal gateway's base URL. JSON requests go through its authenticated
# proxy; the SSE stream still goes direct to VITE_API_URL, because the proxy
# buffers whole responses and would never deliver an open stream.
VITE_GATEWAY_API_URL=
# Origin of the portal shell, for the postMessage handshake. Must match the
# portal exactly — messages from any other origin are ignored.
VITE_PORTAL_ORIGIN=
# `appName` of Prism's record in the portal's Applications table.
VITE_PORTAL_APP_NAME=Prism

# Allowed browser origin(s) for the backend's CORS, comma-separated. Blank =
# reflect any origin (fine locally). In production set to the frontend URL(s),
# e.g. https://app.example.com
CORS_ORIGIN=

# The LLM backend is Groq (default) or AWS Bedrock. Leave both providers'
# credentials blank and every agent falls back to deterministic mock data —
# the app still runs.
LLM_PROVIDER=groq

# --- Groq --- (get a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- AWS Bedrock (only read when LLM_PROVIDER=bedrock) ---
# On AWS (EC2 / ECS) leave the keys blank and set AWS_USE_IAM_ROLE=true — the
# SDK then uses the instance / task role.
AWS_USE_IAM_ROLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Haiku 4.5 by default (fast); use us.anthropic.claude-sonnet-5 for max quality.
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_TIMEOUT_SCALE=2

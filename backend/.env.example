# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# The agents talk to an LLM — Groq (default) or AWS Bedrock. Leave both
# providers' credentials blank/unset and the app runs fine on deterministic
# mock data instead.

# Which backend: 'groq' (default) or 'bedrock'.
LLM_PROVIDER=groq

# --- Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- AWS Bedrock (only read when LLM_PROVIDER=bedrock) ---
# Standard AWS credential env vars. AWS_SESSION_TOKEN is only needed for
# temporary/STS credentials. On AWS (EC2 / ECS) leave the keys blank and set
# AWS_USE_IAM_ROLE=true instead — the SDK then uses the instance/task role.
AWS_USE_IAM_ROLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# A Bedrock model / inference-profile id. Haiku 4.5 is the default — fast
# enough to keep the UI responsive. For higher quality at the cost of speed:
# us.anthropic.claude-sonnet-5
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Multiplies every agent's LLM timeout. Defaults to 2, which suits Haiku 4.5.
# Raise it toward 3 for Sonnet or a slow region if you see "mock fallback" from
# timeouts; lower it for a snappier fall-through to mock.
LLM_TIMEOUT_SCALE=2

# Signs the auth session tokens. Any random string works for local dev — a
# fixed default is used if you leave this blank, which is fine for a POC but
# means every backend instance trusts the same secret. Set a real one before
# deploying anywhere shared. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# When NODE_ENV=production the server refuses to start unless this is set.
JWT_SECRET=

# Set to "production" on a deployed host. Enables the JWT_SECRET startup check
# above; most hosts (Railway, Render, Fly) set this for you.
NODE_ENV=

# Where the SQLite file lives. Leave blank for local dev (uses backend/data.db).
# In production point this at a mounted persistent volume so data survives
# redeploys, e.g. DATABASE_PATH=/data/data.db
DATABASE_PATH=

# Allowed browser origin(s) for CORS, comma-separated. Blank = reflect any
# origin (fine locally). In production set it to the frontend URL(s), e.g.
# CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=

# Optional — enables the "Continue with Google" button. Create an OAuth
# Client ID at https://console.cloud.google.com/apis/credentials (type "Web
# application", add your dev/prod origins under "Authorized JavaScript
# origins"), then set the SAME value here and as VITE_GOOGLE_CLIENT_ID in
# frontend/.env. Leave both blank and the Google button just won't render —
# email/password sign-in works either way.
GOOGLE_CLIENT_ID=

# Which surfaces have their layout generated by the LLM instead of the
# hand-written builders in orchestrator/envelopes.ts. Comma-separated surface
# keys (e.g. flights,hotels) or "all". Unset = every surface stays hand-written.
# A generated layout that fails validation falls back to its builder anyway.
UI_AGENT=

# Output cap per LLM call. Providers count prompt + max_tokens against a
# tokens-per-minute quota, so this trades "large answers get truncated" against
# "every request trips the rate limit". Lower it if the AWS account is
# tightly throttled.
LLM_MAX_TOKENS=8192

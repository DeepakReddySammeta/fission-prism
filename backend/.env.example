# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# The agents can talk to one of two LLM providers, chosen by LLM_PROVIDER:
#   groq     (default) — a free key at https://console.groq.com, no card
#   bedrock            — a Claude model on AWS Bedrock
# Leave the selected provider's credentials blank/unset and the app runs fine
# on deterministic mock data instead.
LLM_PROVIDER=groq

# --- Groq (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=
# Optional — this is already the default if omitted.
GROQ_MODEL=openai/gpt-oss-20b

# --- AWS Bedrock (used when LLM_PROVIDER=bedrock) ---
# Standard AWS credential env vars. AWS_SESSION_TOKEN is only needed for
# temporary/STS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# A Bedrock model / inference-profile id.
BEDROCK_MODEL=us.anthropic.claude-sonnet-5
# Multiplies every agent's LLM timeout. Defaults to 3 for bedrock (Claude
# needs 15-30s for the big prompts vs. Groq's ~3s), 1 for groq. Raise it if
# you still see "mock fallback" from timeouts, lower it for a snappier
# fall-through to mock data.
LLM_TIMEOUT_SCALE=3

# Signs the auth session tokens. Any random string works for local dev — a
# fixed default is used if you leave this blank, which is fine for a POC but
# means every backend instance trusts the same secret. Set a real one before
# deploying anywhere shared. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# When NODE_ENV=production the server refuses to start unless this is set.
JWT_SECRET=

# Set to "production" on a deployed host. Enables the JWT_SECRET startup check
# above; most hosts (Railway, Render, Fly) set this for you.
NODE_ENV=

# Where the SQLite file lives. Leave blank for local dev (uses backend/data.db).
# In production point this at a mounted persistent volume so data survives
# redeploys, e.g. DATABASE_PATH=/data/data.db
DATABASE_PATH=

# Optional — enables the "Continue with Google" button. Create an OAuth
# Client ID at https://console.cloud.google.com/apis/credentials (type "Web
# application", add your dev/prod origins under "Authorized JavaScript
# origins"), then set the SAME value here and as VITE_GOOGLE_CLIENT_ID in
# frontend/.env. Leave both blank and the Google button just won't render —
# email/password sign-in works either way.
GOOGLE_CLIENT_ID=

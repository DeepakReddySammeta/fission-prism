[
  {
    "id": "root",
    "component": "Card",
    "title": "Saved Travel Plans",
    "child": "mainColumn"
  },
  {
    "id": "mainColumn",
    "component": "Column",
    "children": [
      "planList"
    ],
    "gap": 12
  },
  {
    "id": "planList",
    "component": "List",
    "children": [
      {
        "componentId": "planRow",
        "path": "/records"
      }
    ],
    "layout": "stack"
  },
  {
    "id": "planRow",
    "component": "Row",
    "children": [
      "planImage",
      "planTitle",
      "planDestination",
      "planDate",
      "planPrice",
      "planStatus",
      "planButton"
    ],
    "gap": 8,
    "align": "center"
  },
  {
    "id": "planImage",
    "component": "Image",
    "url": {
      "path": "imageUrl"
    },
    "fit": "contain"
  },
  {
    "id": "planTitle",
    "component": "Text",
    "text": {
      "path": "title"
    },
    "variant": "h3"
  },
  {
    "id": "planDestination",
    "component": "Text",
    "text": {
      "path": "destination"
    },
    "variant": "body"
  },
  {
    "id": "planDate",
    "component": "Text",
    "text": {
      "path": "dateLabel"
    },
    "variant": "caption"
  },
  {
    "id": "planPrice",
    "component": "Text",
    "text": {
      "path": "priceLabel"
    },
    "variant": "body"
  },
  {
    "id": "planStatus",
    "component": "Badge",
    "text": {
      "path": "statusLabel"
    },
    "tone": "neutral"
  },
  {
    "id": "planButton",
    "component": "Button",
    "child": "viewLabel",
    "variant": "secondary",
    "action": {
      "event": {
        "name": "viewRecordDetail",
        "context": {
          "recordId": {
            "path": "id"
          }
        }
      }
    }
  },
  {
    "id": "viewLabel",
    "component": "Text",
    "text": "View",
    "variant": "body"
  }
]

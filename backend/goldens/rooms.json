          "id": "rr_price_col",
          "component": "Column",
          "gap": 0,
          "children": [
            "rr_price",
            "rr_pernight"
          ]
        },
        {
          "id": "rr_price",
          "component": "Text",
          "variant": "h3",
          "text": {
            "call": "formatCurrency",
            "args": {
              "value": {
                "path": "price"
              },
              "currency": "INR"
            }
          }
        },
        {
          "id": "rr_pernight",
          "component": "Text",
          "variant": "caption",
          "text": "/ night"
        },
        {
          "id": "rr_btn_label",
          "component": "Text",
          "text": "Book this room"
        },
        {
          "id": "rr_btn",
          "component": "Button",
          "variant": "primary",
          "child": "rr_btn_label",
          "action": {
            "event": {
              "name": "selectRoom",
              "context": {
                "roomId": {
                  "path": "id"
                },
                "checkIn": {
                  "path": "/booking/checkIn"
                },
                "checkOut": {
                  "path": "/booking/checkOut"
                },
                "adults": {
                  "path": "/booking/adults"
                },
                "children": {
                  "path": "/booking/children"
                }
              }
            }
          }
        }
      ]
